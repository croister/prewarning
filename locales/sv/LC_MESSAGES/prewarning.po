#: prewarning.py:186 utils/voice_manager_dialog.py:87
msgid "Language"
msgstr "Språk"

#: prewarning.py:188
msgid "The language used for the application UI."
msgstr "Språket som används för programmets gränssnitt."

#: prewarning.py:198
msgid "Interactive Mode"
msgstr "Interaktivt läge"

#: prewarning.py:201
msgid ""
"Enables or disables the interactive mode. If this is enabled the default "
"method of configuration is via the GUI and if errors are detected in the "
"configuration the Settings Dialog is opened. If this is disabled the "
"configuration file is expected to be used as the means of changing the "
"configuration and if errors are detected in the configuration errors are "
"written to the log and the program exits."
msgstr ""
"Aktiverar eller inaktiverar det interaktiva läget. Om detta är aktiverat "
"är standardmetoden för konfiguration via GUI:t och om fel upptäcks i "
"konfigurationen öppnas inställningsdialogen. Om detta är inaktiverat "
"förväntas konfigurationsfilen användas för att ändra konfigurationen och "
"om fel upptäcks skrivs de till loggen och programmet avslutas."

#: prewarning.py:213
msgid "Announce IP on Startup"
msgstr "Läs upp IP vid start"

#: prewarning.py:216
msgid "Enables or disables the readout of the current IP address at startup."
msgstr ""
"Aktiverar eller inaktiverar uppläsning av aktuell IP-adress vid "
"programmets start."

#: prewarning.py:223
msgid "Enable Intro Sound"
msgstr "Aktivera introljud"

#: prewarning.py:226
msgid ""
"Enable or disable the intro sound played before the first team number is "
"read after a timeout."
msgstr ""
"Aktivera eller inaktivera introljudet som spelas innan det första "
"lagnumret läses upp efter en timeout."

#: prewarning.py:233
msgid "Intro Sound Timeout"
msgstr "Timeout för introljud"

#: prewarning.py:236
msgid ""
"The timeout in seconds after the last announcement before the intro sound"
" is played again before the next announcement."
msgstr ""
"Timeout i sekunder efter det senaste meddelandet innan introljudet spelas"
" igen före nästa meddelande."

#: prewarning.py:246
msgid "Intro Sound"
msgstr "Introljud"

#: prewarning.py:249
msgid "The path to the sound file to use as the intro sound before announcements."
msgstr "Sökvägen till ljudfilen som används som introljud före meddelanden."

#: prewarning.py:263
msgid "Test Sound"
msgstr "Testljud"

#: prewarning.py:265
msgid "The path to the sound file to use as the test sound."
msgstr "Sökvägen till ljudfilen som används som testljud."

#: prewarning.py:272
msgid "Add Pre-Warnings to Bottom"
msgstr "Lägg till förvarningar nederst"

#: prewarning.py:275
msgid ""
"Set to True if new Pre-Warnings should be added to the bottom of the "
"screen."
msgstr "Sätt till sant om nya förvarningar ska läggas till längst ner på skärmen."

#: prewarning.py:282
msgid "Announce Last Leg"
msgstr "Meddela sista sträckan"

#: prewarning.py:285
msgid ""
"If disabled, pre-warnings for the last leg are suppressed (not displayed "
"or announced)."
msgstr ""
"Om inaktiverat skippas förvarningar för sista sträckans löpare (visas "
"eller meddelas inte)."

#: prewarning.py:293
msgid "Prevent Screen Sleep"
msgstr "Förhindra skärmsläckning"

#: prewarning.py:296
msgid ""
"Prevents the display from turning off and the screensaver from activating"
" while the application is running."
msgstr ""
"Förhindrar att skärmen släcks och att skärmsläckaren aktiveras medan "
"applikationen körs."

#: prewarning.py:304 prewarning.py:479
msgid "Control Window"
msgstr "Kontrollfönster"

#: prewarning.py:307
msgid ""
"Open a control window on the secondary landscape display for monitoring "
"and configuration."
msgstr ""
"Öppna ett kontrollfönster på den sekundära liggande skärmen för "
"övervakning och konfiguration."

#: prewarning.py:315
msgid "Deduplicate by Card + Control"
msgstr "Deduplicera efter bricknummer + kodsiffra"

#: prewarning.py:318
msgid ""
"Skip re-announcement when the same SI card punches the same control code "
"again."
msgstr ""
"Hoppa över nytt meddelande när samma SI-bricka stämplar samma kontroll "
"igen."

#: prewarning.py:325
msgid "Deduplicate by Bib + Leg"
msgstr "Deduplicera efter nummerlapp + sträcka"

#: prewarning.py:328
msgid ""
"Skip re-announcement when the same team bib number appears on the same "
"relay leg again."
msgstr ""
"Hoppa över nytt meddelande när samma lagnummer dyker upp på samma sträcka"
" igen."

#: prewarning.py:335
msgid "Dedup Timeout (seconds)"
msgstr "Dedup-timeout (sekunder)"

#: prewarning.py:337
msgid "How long a dedup key remains active. 0 = forever (session)."
msgstr "Hur länge en dedup-nyckel förblir aktiv. 0 = för alltid (session)."

