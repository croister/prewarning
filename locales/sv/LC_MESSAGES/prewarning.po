#: punchsources/__init__.py:101
msgid "Punch Source"
msgstr "Stämplingskälla"

#: punchsources/__init__.py:103
msgid "Determines the source from which Punches are fetched."
msgstr "Bestämmer källan från vilken stämplingar hämtas."

#: punchsources/punch_source_meos.py:29
msgid "MeOS Information Server Punch Source"
msgstr "MeOS Informationsserver Stämplingskälla"

#: punchsources/punch_source_meos.py:32
msgid ""
"Fetches electronic punches from a running <a "
"href=\"https://www.melin.nu/meos/\">MeOS</a> instance via its Information"
" Server REST API. MeOS must have the Information Server enabled (Services"
" → Information Server). For real-time notifications, enable 'Send and "
"receive fast advance information' in MeOS (requires a networked setup)."
msgstr ""
"Hämtar elektroniska stämplingar från en körande <a "
"href=\"https://www.melin.nu/meos/\">MeOS</a>-instans via dess "
"Informationsserver REST API. MeOS måste ha Informationsservern aktiverad "
"(Automater → Informationsserver). För realtidsnotifieringar, aktivera "
"'Skicka och ta emot snabb förhandsinformation om stämplingar och "
"resultat' i MeOS (kräver nätverksuppsättning)."

#: punchsources/punch_source_meos.py:42
#: punchsources/punch_source_olresultat_se.py:278
msgid "Control Codes"
msgstr "Kodsiffror"

#: punchsources/punch_source_meos.py:45
msgid ""
"The control codes to use for pre-warning, separated by space. Use the "
"selector to populate the list from MeOS. The selector shows controls that"
" MeOS has identified as radio controls (controls with a name and OK "
"status, or explicitly flagged as radio). If no such controls exist, all "
"controls in the competition are shown as a fallback."
msgstr ""
"Kodsiffrorna som används för förvarning, separerade med mellanslag. "
"Använd väljaren för att fylla i listan från MeOS. Väljaren visar "
"kontroller som MeOS har identifierat som radiokontroller (kontroller med "
"ett namn och OK-status, eller explicit markerade som radio). Om inga "
"sådana kontroller finns visas alla kontroller i tävlingen som ersättning."

#: punchsources/punch_source_ola_mysql.py:208
msgid "OLA MySQL Punch Source"
msgstr "OLA MySQL Stämplingskälla"

#: punchsources/punch_source_ola_mysql.py:211
msgid ""
"Fetches electronic punches from the MySQL database used by the <a "
"href=\"https://www.svenskorientering.se/Arrangera/itochtavlings-"
"administration/OLAtidtagnings-program/\">OLA event organizing "
"software</a>. These punches have been fetched or received using one of "
"the built-in methods in OLA. OLA must be using MySQL as the database "
"engine, the built-in database is not supported."
msgstr ""
"Hämtar elektroniska stämplingar från MySQL-databasen som används av <a "
"href=\"https://www.svenskorientering.se/Arrangera/itochtavlings-"
"administration/OLAtidtagnings-program/\">tävlingsadministrationsprogramet"
" OLA</a>. Dessa stämplingar har hämtats eller mottagits med en av de "
"inbyggda metoderna i OLA. OLA måste använda MySQL som databasmotor, den "
"inbyggda databasen stöds inte."

#: punchsources/punch_source_ola_mysql.py:220
msgid "Control Ids"
msgstr "Kodsiffror"

#: punchsources/punch_source_ola_mysql.py:223
msgid ""
"The Control IDs to use for Pre-Warning, separated by space. Use the "
"Control Code (Kodsiffra) from OLA, NOT the punching units (Elektronisk "
"stämplingskod)."
msgstr ""
"Kodsiffror som används för förvarning, separerade med mellanslag. Använd "
"kontrollkoden (Kodsiffra) från OLA, INTE enhetskoden (Elektronisk "
"stämplingskod)."

#: punchsources/punch_source_ola_mysql.py:233
#: punchsources/punch_source_olresultat_se.py:266 utils/meos_info_server.py:228
msgid "Fetch Interval"
msgstr "Hämtningsintervall"

#: punchsources/punch_source_ola_mysql.py:236
msgid "The number of seconds between calls to the OLA MySQL database."
msgstr "Antal sekunder mellan anrop till OLA MySQL-databasen."

#: punchsources/punch_source_ola_mysql.py:246
msgid "Last Modified Time"
msgstr "Senaste ändringstid"

#: punchsources/punch_source_ola_mysql.py:249
msgid ""
"The Modified Time of the last retrieved Punch, used to only fetch Punches"
" that are newer. On the format of \"YYYY-MM-DD hh:mm:ss.fff\"."
msgstr ""
"Ändringstiden för den senast hämtade stämplingen, används för att bara "
"hämta nyare stämplingar. I formatet \"YYYY-MM-DD hh:mm:ss.fff\"."

#: punchsources/punch_source_ola_mysql.py:259
#: punchsources/punch_source_olresultat_se.py:231
msgid "Last Received Punch Id"
msgstr "Senast mottaget stämplings-ID"

#: punchsources/punch_source_ola_mysql.py:262
msgid ""
"The Id of the last received Punch, used to not process it again. On the "
"format of `resultRaceIndividualNumber`_`passedCount`_`timingControl` from"
" the table `SplitTimes`, example \"1_1_1\"."
msgstr ""
"ID:t för den senast mottagna stämplingen, används för att inte behandla "
"den igen. I formatet "
"`resultRaceIndividualNumber`_`passedCount`_`timingControl` från tabellen "
"`SplitTimes`, exempel \"1_1_1\"."

#: punchsources/punch_source_olresultat_se.py:202
msgid "OLResultat.se Punch Source"
msgstr "OLResultat.se Stämplingskälla"

#: punchsources/punch_source_olresultat_se.py:205
msgid ""
"Fetches electronic punches from the site <a "
"href=\"https://roc.olresultat.se/\">roc.olresultat.se</a>. These punches "
"have been sent to the site using a Raspberry Pi running the ROC software "
"or an Android device running the <a href=\"http://www.joja.se/\">SI-Droid"
" ROC</a> app."
msgstr ""
"Hämtar elektroniska stämplingar från webbplatsen <a "
"href=\"https://roc.olresultat.se/\">roc.olresultat.se</a>. Dessa "
"stämplingar har skickats till webbplatsen med en Raspberry Pi som kör "
"ROC-programvaran eller en Android-enhet som kör <a "
"href=\"http://www.joja.se/\">SI-Droid ROC</a>-appen."

#: punchsources/punch_source_olresultat_se.py:213 utils/meos_info_server.py:216
msgid "URL"
msgstr "URL"

#: punchsources/punch_source_olresultat_se.py:215
msgid "The URL to the resource that provides the Punches."
msgstr "URL:en till resursen som tillhandahåller stämplingarna."

#: punchsources/punch_source_olresultat_se.py:222
msgid "Competition or Device Id"
msgstr "Tävlings- eller enhets-ID"

#: punchsources/punch_source_olresultat_se.py:224
msgid "The Competition Id or Device Id to fetch Punches from."
msgstr "Tävlings-ID:t eller enhets-ID:t att hämta stämplingar från."

#: punchsources/punch_source_olresultat_se.py:234
msgid ""
"The Id of the last received Punch, used to only fetch Punches with a "
"higher Id."
msgstr ""
"ID:t för den senast mottagna stämplingen, används för att bara hämta "
"stämplingar med ett högre ID."

#: punchsources/punch_source_olresultat_se.py:242
msgid "From Date"
msgstr "Från datum"

#: punchsources/punch_source_olresultat_se.py:245
msgid ""
"The date to fetch Punches from, used to only fetch newer Punches. ISO "
"8601 format (YYYY-MM-DD)"
msgstr ""
"Datumet att hämta stämplingar från, används för att bara hämta nyare "
"stämplingar. ISO 8601-format (YYYY-MM-DD)"

#: punchsources/punch_source_olresultat_se.py:253
msgid "From Time"
msgstr "Från tid"

#: punchsources/punch_source_olresultat_se.py:256
msgid ""
"The time to fetch Punches from, used to only fetch newer Punches. ISO "
"8601 format (hh:mm:ss)"
msgstr ""
"Tiden att hämta stämplingar från, används för att bara hämta nyare "
"stämplingar. ISO 8601-format (hh:mm:ss)"

#: punchsources/punch_source_olresultat_se.py:269
msgid "The number of seconds between calls to the Punch Source URL."
msgstr "Antal sekunder mellan anrop till stämplingskällans URL."

#: punchsources/punch_source_olresultat_se.py:280
msgid "The Control Codes to use for Pre-Warning, separated by space."
msgstr "Kodsiffrorna som används för förvarning, separerade med mellanslag."

#: startlistsources/__init__.py:101
msgid "Start List Source"
msgstr "Startlistkälla"

#: startlistsources/__init__.py:104
msgid "Determines the source of the Start List to look up team information from."
msgstr "Bestämmer startlistkällan som används för att slå upp laginformation."

#: startlistsources/start_list_source_file.py:241
msgid "File Start List Source"
msgstr "Filbaserad Startlistkälla"

#: startlistsources/start_list_source_file.py:244
msgid ""
"Reads a start list file following the <a "
"href=\"https://orienteering.sport/iof/it/data-standard-3-0/\">IOF 3.0 "
"Data Standard</a> and uses it to look up the team bib number and relay "
"leg. Files generated by <a "
"href=\"https://www.orientering.se/forening/arrangor/tavlingsadministration/ola/\">OLA</a>"
" and <a href=\"https://sportsoftware.de/orienteering/os\">OS12</a> have "
"been tested.The file will be monitored and re-read if it changes."
msgstr ""
"Läser en startlistfil enligt <a href=\"https://orienteering.sport/iof/it"
"/data-standard-3-0/\">IOF 3.0 Data Standard</a> och använder den för att "
"slå upp lagets nummerlapp och sträcka. Filer genererade av <a "
"href=\"https://www.orientering.se/forening/arrangor/tavlingsadministration/ola/\">OLA</a>"
" och <a href=\"https://sportsoftware.de/orienteering/os\">OS12</a> har "
"testats. Filen övervakas och läses om vid ändringar."

#: startlistsources/start_list_source_file.py:254
msgid "Start List File"
msgstr "Startlistfil"

#: startlistsources/start_list_source_file.py:257
msgid "The path on the file system where the start list file is located."
msgstr "Sökvägen i filsystemet där startlistfilen finns."

#: startlistsources/start_list_source_file.py:265
msgid "Start List Update Sound"
msgstr "Ljud vid startlistuppdatering"

#: startlistsources/start_list_source_file.py:268
msgid "The path to the sound file to use when the start list is updated."
msgstr "Sökvägen till ljudfilen som spelas när startlistan uppdateras."

#: startlistsources/start_list_source_meos.py:24
msgid "MeOS Information Server Start List Source"
msgstr "MeOS Informationsserver Startlistkälla"

#: startlistsources/start_list_source_meos.py:27
msgid ""
"Looks up team bib number and relay leg from a running <a "
"href=\"https://www.melin.nu/meos/\">MeOS</a> instance via its Information"
" Server REST API. MeOS must have the Information Server enabled (Services"
" → Information Server). If the received punch data already contains the "
"bib number and leg, no operation will be performed."
msgstr ""
"Slår upp lagets nummerlapp och sträcka från en körande <a "
"href=\"https://www.melin.nu/meos/\">MeOS</a>-instans via dess "
"Informationsserver REST API. MeOS måste ha Informationsservern aktiverad "
"(Automater → Informationsserver). Om mottagen stämplingsdata redan "
"innehåller nummerlapp och sträcka utförs ingen operation."

#: startlistsources/start_list_source_ola_mysql.py:22
msgid "OLA MySQL Start List Source"
msgstr "OLA MySQL Startlistkälla"

#: startlistsources/start_list_source_ola_mysql.py:25
msgid ""
"Looks up the team bib number and relay leg from the MySQL database used "
"by the <a href=\"https://www.svenskorientering.se/Arrangera"
"/itochtavlings-administration/OLAtidtagnings-program/\">OLA event "
"organizing software</a>. OLA must be using MySQL as the database engine, "
"the built-in database is not supported. If the received punch data "
"already contains the bib number and leg no operation will be performed."
msgstr ""
"Slår upp lagets nummerlapp och sträcka från MySQL-databasen som används "
"av <a href=\"https://www.svenskorientering.se/Arrangera/itochtavlings-"
"administration/OLAtidtagnings-program/\">tävlingsadministrationsprogramet"
" OLA</a>. OLA måste använda MySQL som databasmotor, den inbyggda "
"databasen stöds inte. Om mottagen stämplingsdata redan innehåller "
"nummerlapp och sträcka utförs ingen operation."

