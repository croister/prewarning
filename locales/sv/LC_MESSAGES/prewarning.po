msgstr "Reparerar"

#: utils/voice_manager_dialog.py:2023
msgid "Installing"
msgstr "Installerar"

#: utils/voice_manager_dialog.py:2032
msgid "Finished"
msgstr "Klara"

#: utils/voice_manager_dialog.py:2059
msgid ""
"An install or repair is currently in progress. Closing will cancel the "
"operation."
msgstr ""
"En installation eller reparation pågår. Stängning kommer avbryta "
"operationen."

#: utils/voice_manager_dialog.py:2066
msgid ""
"One or more extra ranges have invalid values. These ranges will be "
"discarded when closing."
msgstr ""
"Ett eller flera extra intervall har ogiltiga värden. Dessa intervall "
"kommer att tas bort vid stängning."

#: utils/voice_manager_dialog.py:2073
msgid ""
"One or more extra ranges overlap with another range. These ranges will "
"still be saved, but may generate files that already exist."
msgstr ""
"Ett eller flera extra intervall överlappar med ett annat intervall. Dessa"
" intervall sparas ändå, men kan generera filer som redan finns."

#: utils/voice_manager_dialog.py:2082
#, python-brace-format
msgid ""
"The following installed voices are incomplete: {names}. They will not "
"have all required sound files available. Some numbers may fall back to "
"the default ding sound when announced. Use Repair to generate the missing"
" files."
msgstr ""
"Följande installerade röster är ofullständiga: {names}. De kommer inte ha"
" alla nödvändiga ljudfiler tillgängliga. Vissa nummer kan falla tillbaka "
"till standardljudet vid uppläsning. Använd Reparera för att generera de "
"saknade filerna."

#: utils/voice_manager_dialog.py:2092
#, python-brace-format
msgid ""
"The start list bib number range ({min} - {max}) is not fully covered by "
"the configured number ranges. Some bib numbers will not have voice files "
"and will fall back to the default ding sound when announced."
msgstr ""
"Startlistans nummerlappsserie ({min} - {max}) täcks inte helt av de "
"konfigurerade nummerintervallen. Vissa nummerlappsnummer kommer inte att "
"ha röstfiler och faller tillbaka till standardljudet vid uppläsning."

#: utils/voice_manager_dialog.py:2101
msgid "There are issues that may affect voice playback."
msgstr "Det finns problem som kan påverka röstuppspelning."

#: utils/voice_manager_dialog.py:2105
msgid "Close anyway?"
msgstr "Stäng ändå?"

#: utils/voice_manager_dialog.py:2109
msgid "Confirm Close"
msgstr "Bekräfta stängning"

