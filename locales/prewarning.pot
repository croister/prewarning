#: punchsources/__init__.py:101
msgid "Punch Source"
msgstr ""

#: punchsources/__init__.py:103
msgid "Determines the source from which Punches are fetched."
msgstr ""

#: punchsources/punch_source_meos.py:27
msgid "MeOS Information Server Punch Source"
msgstr ""

#: punchsources/punch_source_meos.py:30
msgid ""
"Fetches electronic punches from a running <a "
"href=\"https://www.melin.nu/meos/\">MeOS</a> instance via its Information"
" Server REST API. MeOS must have the Information Server enabled (Services"
" → Information Server). For real-time notifications, enable 'Send and "
"receive fast advance information' in MeOS (requires a networked setup)."
msgstr ""

#: punchsources/punch_source_meos.py:40
#: punchsources/punch_source_olresultat_se.py:276
msgid "Control Codes"
msgstr ""

#: punchsources/punch_source_meos.py:43
msgid ""
"The control codes to use for pre-warning, separated by space. Use the "
"selector to populate the list from MeOS. The selector shows controls that"
" MeOS has identified as radio controls (controls with a name and OK "
"status, or explicitly flagged as radio). If no such controls exist, all "
"controls in the competition are shown as a fallback."
msgstr ""

#: punchsources/punch_source_ola_mysql.py:199
msgid "OLA MySQL Punch Source"
msgstr ""

#: punchsources/punch_source_ola_mysql.py:202
msgid ""
"Fetches electronic punches from the MySQL database used by the <a "
"href=\"https://www.svenskorientering.se/Arrangera/itochtavlings-"
"administration/OLAtidtagnings-program/\">OLA event organizing "
"software</a>. These punches have been fetched or received using one of "
"the built-in methods in OLA. OLA must be using MySQL as the database "
"engine, the built-in database is not supported."
msgstr ""

#: punchsources/punch_source_ola_mysql.py:211
msgid "Control Ids"
msgstr ""

#: punchsources/punch_source_ola_mysql.py:214
msgid ""
"The Control IDs to use for Pre-Warning, separated by space. Use the "
"Control Code (Kodsiffra) from OLA, NOT the punching units (Elektronisk "
"stämplingskod)."
msgstr ""

#: punchsources/punch_source_ola_mysql.py:224
#: punchsources/punch_source_olresultat_se.py:264 utils/meos_info_server.py:230
msgid "Fetch Interval"
msgstr ""

#: punchsources/punch_source_ola_mysql.py:227
msgid "The number of seconds between calls to the OLA MySQL database."
msgstr ""

#: punchsources/punch_source_ola_mysql.py:237
msgid "Last Modified Time"
msgstr ""

#: punchsources/punch_source_ola_mysql.py:240
msgid ""
"The Modified Time of the last retrieved Punch, used to only fetch Punches"
" that are newer. On the format of \"YYYY-MM-DD hh:mm:ss.fff\"."
msgstr ""

#: punchsources/punch_source_ola_mysql.py:250
#: punchsources/punch_source_olresultat_se.py:229
msgid "Last Received Punch Id"
msgstr ""

#: punchsources/punch_source_ola_mysql.py:253
msgid ""
"The Id of the last received Punch, used to not process it again. On the "
"format of `resultRaceIndividualNumber`_`passedCount`_`timingControl` from"
" the table `SplitTimes`, example \"1_1_1\"."
msgstr ""

#: punchsources/punch_source_olresultat_se.py:200
msgid "OLResultat.se Punch Source"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:203
msgid ""
"Fetches electronic punches from the site <a "
"href=\"https://roc.olresultat.se/\">roc.olresultat.se</a>. These punches "
"have been sent to the site using a Raspberry Pi running the ROC software "
"or an Android device running the <a href=\"http://www.joja.se/\">SI-Droid"
" ROC</a> app."
msgstr ""

#: punchsources/punch_source_olresultat_se.py:211 utils/meos_info_server.py:218
msgid "URL"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:213
msgid "The URL to the resource that provides the Punches."
msgstr ""

#: punchsources/punch_source_olresultat_se.py:220
msgid "Competition or Device Id"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:222
msgid "The Competition Id or Device Id to fetch Punches from."
msgstr ""

#: punchsources/punch_source_olresultat_se.py:232
msgid ""
"The Id of the last received Punch, used to only fetch Punches with a "
"higher Id."
msgstr ""

#: punchsources/punch_source_olresultat_se.py:240
msgid "From Date"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:243
msgid ""
"The date to fetch Punches from, used to only fetch newer Punches. ISO "
"8601 format (YYYY-MM-DD)"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:251
msgid "From Time"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:254
msgid ""
"The time to fetch Punches from, used to only fetch newer Punches. ISO "
"8601 format (hh:mm:ss)"
msgstr ""

#: punchsources/punch_source_olresultat_se.py:267
msgid "The number of seconds between calls to the Punch Source URL."
msgstr ""

#: punchsources/punch_source_olresultat_se.py:278
msgid "The Control Codes to use for Pre-Warning, separated by space."
msgstr ""

#: startlistsources/__init__.py:101
msgid "Start List Source"
msgstr ""

#: startlistsources/__init__.py:104
msgid "Determines the source of the Start List to look up team information from."
msgstr ""

#: startlistsources/start_list_source_file.py:240
msgid "File Start List Source"
msgstr ""

#: startlistsources/start_list_source_file.py:243
msgid ""
"Reads a start list file following the <a "
"href=\"https://orienteering.sport/iof/it/data-standard-3-0/\">IOF 3.0 "
"Data Standard</a> and uses it to look up the team bib number and relay "
"leg. Files generated by <a "
"href=\"https://www.orientering.se/forening/arrangor/tavlingsadministration/ola/\">OLA</a>"
" and <a href=\"https://sportsoftware.de/orienteering/os\">OS12</a> have "
"been tested.The file will be monitored and re-read if it changes."
msgstr ""

#: startlistsources/start_list_source_file.py:253
msgid "Start List File"
msgstr ""

#: startlistsources/start_list_source_file.py:256
msgid "The path on the file system where the start list file is located."
msgstr ""

#: startlistsources/start_list_source_file.py:264
msgid "Start List Update Sound"
msgstr ""

#: startlistsources/start_list_source_file.py:267
msgid "The path to the sound file to use when the start list is updated."
msgstr ""

#: startlistsources/start_list_source_meos.py:22
msgid "MeOS Information Server Start List Source"
msgstr ""

#: startlistsources/start_list_source_meos.py:25
msgid ""
"Looks up team bib number and relay leg from a running <a "
"href=\"https://www.melin.nu/meos/\">MeOS</a> instance via its Information"
" Server REST API. MeOS must have the Information Server enabled (Services"
" → Information Server). If the received punch data already contains the "
"bib number and leg, no operation will be performed."
msgstr ""

#: startlistsources/start_list_source_ola_mysql.py:21
msgid "OLA MySQL Start List Source"
msgstr ""

#: startlistsources/start_list_source_ola_mysql.py:24
msgid ""
"Looks up the team bib number and relay leg from the MySQL database used "
"by the <a href=\"https://www.svenskorientering.se/Arrangera"
"/itochtavlings-administration/OLAtidtagnings-program/\">OLA event "
"organizing software</a>. OLA must be using MySQL as the database engine, "
"the built-in database is not supported. If the received punch data "
"already contains the bib number and leg no operation will be performed."
msgstr ""

